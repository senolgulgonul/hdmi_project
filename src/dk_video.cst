// Tang Nano 9K (GW1NR-9C) pin constraints
// For use with DVI TX IP regenerated for GW1NR-9C with ELVDS output type
//
// NOTE: No IO_PORT lines for TMDS signals — the ELVDS primitives inside
// the regenerated dvi_tx.v IP define the IO type internally. Adding
// IO_PORT constraints on those pins causes CT1109 errors.

// Clock: 27MHz onboard oscillator (Bank 4, 3.3V)
IO_LOC "I_clk" 52;
IO_PORT "I_clk" IO_TYPE=LVCMOS33;

// Reset: onboard button S2 (Bank 3, 1.8V, active low)
IO_LOC "I_rst_n" 4;
IO_PORT "I_rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// LEDs (Bank 3, 1.8V — active low on Tang Nano 9K)
IO_LOC "O_led[0]" 10;
IO_LOC "O_led[1]" 11;
IO_LOC "O_led[2]" 13;
IO_LOC "O_led[3]" 14;

IO_PORT "O_led[0]" IO_TYPE=LVCMOS18;
IO_PORT "O_led[1]" IO_TYPE=LVCMOS18;
IO_PORT "O_led[2]" IO_TYPE=LVCMOS18;
IO_PORT "O_led[3]" IO_TYPE=LVCMOS18;

//======================================
// HDMI TX (onboard HDMI connector, Bank 1, 3.3V)
// IO_PORT deliberately omitted — ELVDS type is set inside the IP primitives
IO_LOC "O_tmds_clk_p"     69,68;
IO_LOC "O_tmds_data_p[0]" 71,70;
IO_LOC "O_tmds_data_p[1]" 73,72;
IO_LOC "O_tmds_data_p[2]" 75,74;
